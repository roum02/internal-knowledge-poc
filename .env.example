# Example credentials for local development only.
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

# Optional: Python connects to the DB running on this Mac.
POSTGRES_HOST=127.0.0.1
# Optional: override only Python's connection port (normally POSTGRES_PORT).
# POSTGRES_CONNECT_PORT=5432
# Default: cpu. On supported Apple Silicon Macs, mps can use the GPU.
EMBEDDING_DEVICE=cpu
